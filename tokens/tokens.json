{
  "$meta": {
    "name": "e911-design-system",
    "version": "1.6.0",
    "direction": "Terrazzo × Solstice",
    "type": "Grotesk Standard (Space Grotesk / Onest / JetBrains Mono)",
    "locked": "2026-08-14",
    "a11y": "WCAG 2.1 AA verified for all text/surface pairs by scripts/contrast-audit.mjs; focus indicator is two-tone (ring + halo) and scored on both tones; form-control boundaries meet 1.4.11 at 3:1 via border.control (1.5.0); Checkbox/Radio box, fill and mark audited as non-text contrast in both themes (1.6.0); status = pill + dot + word, never color alone"
  },
  "primitive": {
    "color": {
      "brand": {
        "value": "#E8690A",
        "comment": "Logo orange. Seal + ribbon gradient only; never text."
      },
      "orange": {
        "300": "#FFA066",
        "400": "#F5803D",
        "500": "#E06405",
        "600": "#C74F00",
        "700": "#A83B00",
        "800": "#8A2800"
      },
      "warm": {
        "25": "#FBF9F6",
        "50": "#F8F6F3",
        "100": "#F2EDE5",
        "200": "#E8E0D4",
        "300": "#D9CEBD",
        "400": "#B6A794",
        "500": "#9A8977",
        "550": "#786856",
        "600": "#6C5C4B",
        "700": "#52443A",
        "800": "#40342A",
        "900": "#31261C",
        "950": "#211913",
        "990": "#0B0806"
      },
      "edge": {
        "orange": "#C74F00",
        "teal": "#0E7A70",
        "gold": "#B98300",
        "green": "#2F7A34",
        "plum": "#6D4FC4",
        "blue": "#2E5FAE"
      },
      "green": {
        "100": "#E7F2E3",
        "700": "#2F6B2E"
      },
      "gold": {
        "100": "#F7EFD7",
        "700": "#7E6000"
      },
      "red": {
        "100": "#F9E7E1",
        "700": "#A63A22"
      }
    },
    "font": {
      "display": {
        "value": "Space Grotesk",
        "weights": [
          500,
          600,
          700
        ],
        "roles": "headings, KPI numerals"
      },
      "body": {
        "value": "Onest",
        "weights": [
          400,
          500,
          600,
          700
        ],
        "roles": "UI text, tables, forms"
      },
      "mono": {
        "value": "JetBrains Mono",
        "weights": [
          400,
          500
        ],
        "roles": "dates, IDs, deltas, cert codes; tabular-nums"
      }
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px"
    },
    "radius": {
      "xs": "5px",
      "xsComment": "Checkbox box only (1.6.0). 8px on an 18px square reads as a circle and collides with Radio; 5px keeps the same corner language at a quarter of the area.",
      "sm": "8px",
      "md": "10px",
      "lg": "14px",
      "pill": "999px"
    },
    "motion": {
      "ease": "cubic-bezier(0.2, 0.8, 0.3, 1)",
      "durationFast": "110ms",
      "duration": "170ms"
    },
    "metric": {
      "controlHeight": "32px",
      "controlHeightSm": "28px",
      "tapTarget": "44px",
      "checkSize": "18px",
      "checkSizeTap": "24px",
      "checkSizeComment": "Painted box of Checkbox/Radio (1.6.0). Not a tap target — the label row is, and it is tapTarget tall in both sizes.",
      "rowHeight": "40px",
      "cardEdgeWidth": "4px",
      "railWidth": "64px",
      "railWidthExpanded": "224px"
    },
    "layer": {
      "rail": "40",
      "popover": "50",
      "dialog": "60",
      "toast": "70"
    },
    "fontSize": {
      "comment": "Component-scale sizes that app code may need to name. The rest of the scale lives in tokens.css.",
      "ribbonMeta": "12.5px"
    }
  },
  "semantic": {
    "light": {
      "surface": {
        "canvas": "{color.warm.50}",
        "card": "#FFFFFF",
        "sunken": "{color.warm.25}",
        "tint": "{color.warm.100}",
        "brandSoft": "#FCEBDB"
      },
      "border": {
        "default": "{color.warm.200}",
        "strong": "{color.warm.300}",
        "row": "{color.warm.100}",
        "control": "{color.warm.500}",
        "controlComment": "Form-control boundary (input, Select, DateField) — 3.38:1 on surface.card, the WCAG 1.4.11 floor. Separate tier from border.default, which separates rather than identifies and stays waived."
      },
      "text": {
        "primary": "{color.warm.900}",
        "secondary": "{color.warm.600}",
        "tertiary": "{color.warm.550}",
        "onAction": "#FFFFFF",
        "onDanger": "#FFFFFF",
        "brand": "{color.orange.700}"
      },
      "action": {
        "primary": "{color.orange.600}",
        "primaryHover": "{color.orange.700}",
        "focusRing": "{color.orange.600}",
        "focusRingHalo": "{color.warm.990}"
      },
      "status": {
        "ok": "{color.green.700}",
        "okSoft": "{color.green.100}",
        "warn": "{color.gold.700}",
        "warnSoft": "{color.gold.100}",
        "bad": "{color.red.700}",
        "badSoft": "{color.red.100}"
      },
      "ribbon": {
        "gradient": "linear-gradient(115deg, #A83B00, #C74F00 58%, #D8912B)",
        "text": "#FFFFFF",
        "actionSurface": "#FFFFFF",
        "actionText": "{color.orange.700}",
        "actionsScrim": "rgba(33,25,19,0.35)",
        "ghostHover": "rgba(33,25,19,0.30)"
      },
      "shadow": {
        "card": "0 1px 2px rgba(49,38,28,0.05)",
        "pop": "0 8px 30px -12px rgba(49,38,28,0.28)"
      }
    },
    "dark": {
      "surface": {
        "canvas": "#14100D",
        "card": "#1E1814",
        "sunken": "#191410",
        "tint": "#28211B",
        "brandSoft": "rgba(245,128,61,0.14)"
      },
      "border": {
        "default": "#54443A",
        "strong": "#6B5A4D",
        "row": "{color.warm.800}",
        "control": "{color.warm.550}",
        "controlComment": "3.27:1 on surface.card. Lighter than border.strong on purpose — this tier is an accessibility floor, not a decorative step."
      },
      "text": {
        "primary": "#F7EFE8",
        "secondary": "#B4A197",
        "tertiary": "#9A877D",
        "onAction": "#1A0E05",
        "onDanger": "{color.warm.950}",
        "brand": "{color.orange.300}"
      },
      "action": {
        "primary": "{color.orange.500}",
        "primaryHover": "{color.orange.400}",
        "focusRing": "{color.orange.300}",
        "focusRingHalo": "{color.warm.990}"
      },
      "status": {
        "ok": "#5BC46F",
        "okSoft": "rgba(91,196,111,0.14)",
        "warn": "#E7B93C",
        "warnSoft": "rgba(231,185,60,0.14)",
        "bad": "#F26D5F",
        "badSoft": "rgba(242,109,95,0.15)"
      },
      "ribbon": {
        "gradient": "linear-gradient(115deg, #6F1600, #A83B00 58%, #B98300)",
        "text": "#FFF4E8",
        "actionSurface": "#FFFFFF",
        "actionText": "{color.orange.700}",
        "actionsScrim": "rgba(33,25,19,0.35)",
        "ghostHover": "rgba(33,25,19,0.30)"
      },
      "shadow": {
        "card": "0 1px 2px rgba(0,0,0,0.5)",
        "pop": "0 12px 34px -14px rgba(0,0,0,0.8)"
      }
    }
  }
}
